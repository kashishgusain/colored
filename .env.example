# Flask
SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=true

# Groq (https://console.groq.com) - free tier API key.
# Leave blank to run in DEMO MODE: the app will clearly label any
# AI output as demo/fallback instead of pretending it is live.
GROQ_API_KEY=

# Model IDs - check https://console.groq.com/docs/models for current names,
# these change over time. Defaults below are reasonable as of writing.
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.1-70b-versatile

# SQLite file path
DATABASE_PATH=lokvaani.db
