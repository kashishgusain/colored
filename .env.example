# Copy to .env and edit. NEVER commit .env. Values below are placeholders, not real credentials.
APP_ENV=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string   # required in production: python -c "import secrets;print(secrets.token_hex(32))"
# DATABASE_URL=postgresql+psycopg2://user:password@localhost/lokvaani   # default: SQLite in instance/

# ---- Speech-to-text -------------------------------------------------------------
# none | faster_whisper (free, local, downloads a model on first use) | openai (needs key)
TRANSCRIPTION_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=small            # tiny | base | small | medium  (bigger = slower, more accurate)

# ---- Optional OpenAI (summaries, metadata, translation, chatbot answers) -----------
OPENAI_API_KEY=                     # leave empty to run without any paid API
LLM_PROVIDER=none                   # none | openai
TRANSLATION_PROVIDER=none           # none | openai
OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                  # any OpenAI-compatible endpoint (e.g. a local server)

# ---- YouTube transcript extraction (RapidAPI) ------------------------------------
RAPIDAPI_KEY=                       # required for the YouTube transcript preview
# YOUTUBE_TRANSCRIPT_API_URL=https://youtube-transcript3.p.rapidapi.com/api/transcript
# YOUTUBE_TRANSCRIPT_API_HOST=youtube-transcript3.p.rapidapi.com

# ---- Semantic search ----------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers   # sentence_transformers | none
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Misc ------------------------------------------------------------------------------
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# PORT=5000
MAX_AUDIO_MB=100
MAX_VIDEO_MB=200
